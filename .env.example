# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=INKPULSE

# ─── Supabase (Project Settings → API) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay (Dashboard → Account & Settings → API keys / Webhooks) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes an uncaptured (backed) payment stays authorised before the gateway
# auto-reverses it. Must cover Monday → Thursday lock + buffer. Confirm the
# maximum your Razorpay account allows.
RAZORPAY_MANUAL_EXPIRY_MINUTES=7200

# ─── Scheduled jobs ───────────────────────────────────────────────────
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=

# ─── Print partner ────────────────────────────────────────────────────
# csv     → batch CSV saved to Supabase Storage + emailed to PRINT_OPS_EMAIL
# webhook → batch JSON POSTed to PRINT_PARTNER_URL (map to Qikink/Printrove API)
PRINT_PARTNER_MODE=csv
PRINT_PARTNER_URL=
PRINT_PARTNER_API_KEY=
PRINT_OPS_EMAIL=ops@example.com

# ─── Email (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="INKPULSE <drops@yourdomain.in>"

# ─── WhatsApp (any BSP with an HTTP template API: Gupshup, Interakt, AiSensy…) ─
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ─── Web push (run: npm run vapid) ────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.in
